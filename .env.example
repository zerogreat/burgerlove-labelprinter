# Copy this file to .env and adjust for your environment.

# Zebra ZD411 network address. Leave as-is for local UI testing; print
# attempts will just fail gracefully with a visible error until the printer
# is reachable.
PRINTER_IP=192.168.1.50
PRINTER_PORT=9100

# Single shared admin login for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Signs the admin session cookie. Set to a random string before running
# anywhere but your own machine.
SECRET_KEY=dev-secret-change-me
